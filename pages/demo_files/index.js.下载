    quanp();
    $(function(){
        var nav = $('.cd-header'),
        doc = $(document),
        win = $(window);
        win.scroll(function() {
            if (doc.scrollTop() > 80) {
                nav.addClass('scrolled');
                $(".wlogo").css({"display":"none"});
                $(".clogo").css({"display":"block"});
            } else {
                nav.removeClass('scrolled');
                $(".clogo").css({"display":"none"});
                $(".wlogo").css({"display":"block"});
            }
        });
        win.scroll();


        $(window).scroll(function () {
            var clientH = $(window).height();
            var $scroll = $(window).scrollTop();
            let height = ($(this).height()) + $(this).scrollTop();
            // console.log($('#num_1').offset().top -$scroll)
            if ($('#num_1').offset().top -$scroll < 600) {
                $('#num_1 .ab_text').addClass('animate__fadeInUp');
                $('#num_1 .ab_introduce').addClass('animate__fadeInUp');
            } else {
                $('#num_1 .ab_text').removeClass('animate__fadeInUp');
                $('#num_1 .ab_introduce').removeClass('animate__fadeInUp');
            }
            if ($('#num_3 .hx_tit').offset().top -$scroll < clientH/2) {
                $('#num_3 .hx_con>div').addClass('animate__fadeInUp');
            } else {
                $('#num_3 .hx_con>div').removeClass('animate__fadeInUp');
            }
            if ($('#num_5').offset().top -$scroll < 600) {
             $('#num_5 .fw_con>div').addClass('animate__fadeInUp');
            } else {
             $('#num_5 .fw_con>div').removeClass('animate__fadeInUp');
            }
            $(".num").each(function () {
                var $height = $(this).height();
                var $off = $(this).offset().top;
                var $index = $(this).index();
                // if($index==5 && $off- $scroll<900){
                //     $(".fixed_r>div>ul>li").eq(4).addClass("on");
                //     $(".fixed_r>div>ul>li").eq(4).siblings().removeClass("on");
                // }
                if ($off - $scroll < clientH/2) {
                    if($index<3){
                        $(".fixed_r>div>ul>li").eq($index).addClass("on");
                        $(".fixed_r>div>ul>li").eq($index).siblings().removeClass("on");
                    }
                } else {
                    $(".fixed_r>div>ul>li").eq($index).removeClass("on");
                }
            })
        });

        $(".smooth").on("click", function () {
            var href = $(this).attr("href");
            var $step = $(href).offset().top;
            $('html,body').animate({scrollTop: $step}, 600);
            return false;
        })
        
    })